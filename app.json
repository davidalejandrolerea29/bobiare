{
  "name": "Bobiare",
  "slug": "bobiare",
  "owner": "n7softwares",
  "version": "1.0.0",
  "scheme": "bobiare",
  "userInterfaceStyle": "light",
  "icon": "./assets/logo2.png",
  "splash": {
    "image": "./assets/splash-icon.png",
    "resizeMode": "contain",
    "backgroundColor": "#ffffff"
  },
  "android": {
    "package": "com.bobiare",
    "googleServicesFile": "./google-services.json",
    "permissions": ["android.permission.POST_NOTIFICATIONS"],
    "intentFilters": [
      {
        "action": "VIEW",
        "autoVerify": true,
        "data": [
          {
            "scheme": "https",
            "host": "bobiare.n7softwares.com",
            "pathPrefix": "/confirmacion"
          }
        ],
        "category": [
          "BROWSABLE",
          "DEFAULT"
        ]
      }
    ],
    "adaptiveIcon": {
      "foregroundImage": "./assets/logo2.png",
      "backgroundColor": "#ffffff"
    }
  },
  "ios": {
    "bundleIdentifier": "com.bobiare",
    "googleServicesFile": "./GoogleService-Info.plist",
    "entitlements": {
      "aps-environment": "production"
    },
    "associatedDomains": [
      "applinks:bobiare.n7softwares.com",
      "applinks:bobiare.n7softwares.com"
    ],
    "infoPlist": {
      "ITSAppUsesNonExemptEncryption": false,
      "UIBackgroundModes": ["remote-notification"]
    }
  },
  "plugins": [
    "expo-font",
    "expo-asset",
    [
      "expo-image-picker",
      {
        "photosPermission": "Bobiare necesita acceder a tus fotos para analizar la pieza.",
        "cameraPermission": "Bobiare necesita usar la cámara para fotografiar la pieza.",
        "microphonePermission": false
      }
    ],
    "@react-native-firebase/app",
    "@react-native-firebase/messaging",
    [
      "expo-build-properties",
      {
        "ios": {
          "useFrameworks": "dynamic"
        }
      }
    ]
  ],
  "extra": {
    "eas": {
      "projectId": "5df60eb5-8be8-4df5-99c8-0334beeeb83d"
    }
  }
}
